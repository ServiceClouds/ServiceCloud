{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "AppOptions": {
    "ConnectionStrings": {
      "MasterDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=ServiceCloud;Trusted_Connection=True;TrustServerCertificate=True;"
    },

    "BearerTokens": {
      "Key": "YourSuperSecretKeyHere123456789",
      "Issuer": "ServiceCloudAPI",
      "Audience": "ServiceCloudUsers",
      "AccessTokenExpirationInHours": 2,
      "RefreshTokenExpirationMinutes": 1440
    },

    "AppSetting": {
      "IsProduction": false
    }
  }
}